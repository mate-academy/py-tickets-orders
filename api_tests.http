### 2.3) Movie Sessions - detalhe (calcula 2 lugares livres; com fallback)
GET {{base}}/api/cinema/movie_sessions/{{session_id}}/
Accept: application/json

> {%
try {
  if (response.status === 200) {
    const d = (typeof response.body === 'string') ? JSON.parse(response.body) : response.body;
    const rows = d.cinema_hall.rows;
    const seats = d.cinema_hall.seats_in_row;
    const taken = new Set((d.taken_places || []).map(p => `${p.row}:${p.seat}`));
    const free = [];
    for (let r=1; r<=rows; r++){
      for (let s=1; s<=seats; s++){
        if (!taken.has(`${r}:${s}`)) free.push([r,s]);
        if (free.length===2) break;
      }
      if (free.length===2) break;
    }
    const [a,b] = free.length===2 ? free : [[1,1],[1,2]];
    client.global.set("row1", a[0]); client.global.set("seat1", a[1]);
    client.global.set("row2", b[0]); client.global.set("seat2", b[1]);
  } else {
    client.global.set("row1", 1); client.global.set("seat1", 1);
    client.global.set("row2", 1); client.global.set("seat2", 2);
  }
} catch(e) {
  client.global.set("row1", 1); client.global.set("seat1", 1);
  client.global.set("row2", 1); client.global.set("seat2", 2);
}
%}


### 3) Orders - lista (Basic Auth; sem CSRF)
GET {{base}}/api/cinema/orders/
Accept: application/json
Authorization: {{auth}}

> {% client.test("orders list 200", () => client.assert(response.status === 200)); %}

### 3.1) Orders - criar pedido com assentos livres (Basic Auth)
POST {{base}}/api/cinema/orders/
Content-Type: application/json
Accept: application/json
Authorization: {{auth}}

{
  "tickets": [
    {"row": {{row1}}, "seat": {{seat1}}, "movie_session": {{session_id}}},
    {"row": {{row2}}, "seat": {{seat2}}, "movie_session": {{session_id}}}
  ]
}

> {%
// Para reruns: consideramos OK 201/200 (criado) OU 400 (assentos já tomados)
client.test("order created ou já existente (ok em reruns)", () => {
  client.assert([200,201,400].includes(response.status));
});
%}

### 3.2) Orders - lista pós-criação
GET {{base}}/api/cinema/orders/
Accept: application/json
Authorization: {{auth}}

> {% client.test("orders list after create 200", () => client.assert(response.status === 200)); %}
