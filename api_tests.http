### 2) Movie Sessions - lista (escolhe sessão com bastante vagas)
GET {{base}}/api/cinema/movie_sessions/
Accept: application/json

> {%
try {
  const body = (typeof response.body === 'string') ? JSON.parse(response.body) : response.body;
  const results = (body && body.results) ? body.results : [];
  // 1º preferimos >=10 livres; 2º >=2; 3º qualquer uma
  let sid = null;
  for (const s of results) { if ((s.tickets_available ?? 0) >= 10) { sid = s.id; break; } }
  if (!sid) for (const s of results) { if ((s.tickets_available ?? 0) >= 2) { sid = s.id; break; } }
  if (!sid && results.length) sid = results[0].id;
  client.global.set("session_id", sid ?? 1);
} catch(e) {
  client.global.set("session_id", 1);
}
client.test("sessions list 200", () => client.assert(response.status === 200));
%}

